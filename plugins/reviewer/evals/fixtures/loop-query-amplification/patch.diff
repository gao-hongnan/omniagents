@@ -1,3 +1,10 @@
 """Display helpers for the dashboard."""
 
+import functools
+
 PRIORITY_LEVELS = ("low", "medium", "high", "urgent")
+
+
+@functools.lru_cache(maxsize=128)
+def badge_for(level: str) -> str:
+    return f"badge-{PRIORITY_LEVELS.index(level)}"
