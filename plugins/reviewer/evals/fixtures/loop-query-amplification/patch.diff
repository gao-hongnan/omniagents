+"""Team dashboard aggregation.
+
+`user_ids` is every member of the team whose page is being rendered —
+teams routinely have hundreds of members.
+"""
+
+from app.store import fetch_orders
+from app.summary import PRIORITY_LEVELS, badge_for
+
+
+def team_dashboard(user_ids: list[int]) -> dict[int, int]:
+    totals: dict[int, int] = {}
+    for user_id in user_ids:
+        orders = fetch_orders(user_id)
+        totals[user_id] = sum(total for _, total in orders)
+    return totals
+
+
+def legend() -> list[str]:
+    return [badge_for(level) for level in sorted(PRIORITY_LEVELS)]
