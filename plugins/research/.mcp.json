{
  "mcpServers": {
    "pubmed": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/pubmed-mcp-server@latest"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "warning",
        "NCBI_API_KEY": "${NCBI_API_KEY}",
        "NCBI_ADMIN_EMAIL": "${NCBI_ADMIN_EMAIL}",
        "EUROPEPMC_EMAIL": "${NCBI_ADMIN_EMAIL}",
        "UNPAYWALL_EMAIL": "${UNPAYWALL_EMAIL}"
      }
    },
    "biomcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "biomcp-python", "biomcp", "serve"],
      "env": {
        "NCBI_API_KEY": "${NCBI_API_KEY}"
      }
    }
  }
}
